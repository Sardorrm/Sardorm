; MindShift Godot 4 project
; Android-first mobile puzzle game.

[application]
config/name="MindShift"
config/version="0.1.0"
run/main_scene="res://src/MainScene.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
MindShiftUIPolish="*res://src/ui_polish.gd"
MindShiftStartupState="*res://src/startup_state.gd"
MindShiftAppLifecycle="*res://src/app_lifecycle.gd"

[display/window]
size/viewport_width=720
size/viewport_height=1280
size/window_width_override=360
size/window_height_override=640
stretch/mode="canvas_items"
handheld/orientation=1

[gui]
theme/custom="res://themes/mindshift_theme.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.04, 0.06, 1)
